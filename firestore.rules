rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Proposed fail-closed baseline. The app does not yet obtain Firebase Auth
    // credentials, so do not deploy without migrating and testing all features.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
