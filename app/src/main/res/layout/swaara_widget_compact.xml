<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_compact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_compact_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/widget_compact_art"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/widget_art_bg"
        android:scaleType="centerCrop"
        android:src="@drawable/app_icon"
        android:contentDescription="Artwork" />

    <LinearLayout
        android:id="@+id/widget_compact_info_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/widget_compact_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="A1 Swaara"
            android:textColor="#FFFFFFFF"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_compact_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Studio Audio"
            android:textColor="#A8A8BD"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_compact_prev"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:padding="6dp"
        android:src="@drawable/ic_widget_prev"
        android:contentDescription="Previous" />

    <ImageView
        android:id="@+id/widget_compact_play_pause"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/widget_play_btn_bg"
        android:padding="8dp"
        android:src="@drawable/ic_widget_play"
        android:contentDescription="Play or Pause" />

    <ImageView
        android:id="@+id/widget_compact_next"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:padding="6dp"
        android:src="@drawable/ic_widget_next"
        android:contentDescription="Next" />

</LinearLayout>
