<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_studio_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_studio_bg"
    android:padding="12dp">

    <ImageView
        android:id="@+id/widget_studio_art"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:background="@drawable/widget_art_bg"
        android:scaleType="centerCrop"
        android:src="@drawable/app_icon"
        android:contentDescription="Artwork" />

    <LinearLayout
        android:id="@+id/widget_studio_info_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toEndOf="@id/widget_studio_art"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/widget_studio_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A1 SWAARA • STUDIO"
            android:textColor="#20CFFF"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:singleLine="true" />

        <TextView
            android:id="@+id/widget_studio_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="A1 Swaara"
            android:textColor="#FFFFFFFF"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_studio_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Tap to play music"
            android:textColor="#B0B0C4"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_studio_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_toEndOf="@id/widget_studio_art"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="0dp">

        <ImageView
            android:id="@+id/widget_studio_prev"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="6dp"
            android:src="@drawable/ic_widget_prev"
            android:contentDescription="Previous" />

        <ImageView
            android:id="@+id/widget_studio_play_pause"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_play_btn_bg"
            android:padding="8dp"
            android:src="@drawable/ic_widget_play"
            android:contentDescription="Play or Pause" />

        <ImageView
            android:id="@+id/widget_studio_next"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:padding="6dp"
            android:src="@drawable/ic_widget_next"
            android:contentDescription="Next" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/widget_studio_like"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="6dp"
            android:src="@drawable/ic_widget_heart_outline"
            android:contentDescription="Like" />
    </LinearLayout>

</RelativeLayout>
