# SWAARA_SUPABASE_ANON_KEY=your_public_anon_key
# SWAARA_GOOGLE_WEB_CLIENT_ID=your_web_client_id
# SWAARA_GOOGLE_ANDROID_CLIENT_ID=your_android_client_id
